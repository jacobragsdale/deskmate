{
  "name": "player-two",
  "productName": "Player Two",
  "version": "0.4.0",
  "description": "Player Two: chat with your teammates and their coding agents.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "player-two": "dist/player-two.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pretest": "node build.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "package:win": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  },
  "build": {
    "appId": "io.github.jacobragsdale.player-two",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/wsl-runtime.tar.gz*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "dist/wsl-runtime.tar.gz",
          "to": "wsl-runtime.tar.gz"
        },
        {
          "from": "dist/wsl-runtime.tar.gz.sha256",
          "to": "wsl-runtime.tar.gz.sha256"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "publish": null,
    "nsis": {
      "artifactName": "player-two-setup.exe"
    }
  }
}
