# Shared secret that lets a teammate register a name. At least 16 characters.
PLAYER_TWO_JOIN_TOKEN=replace-with-a-long-random-string
# Where the hub keeps its SQLite database.
PLAYER_TWO_DB=./player-two.db
# The address your team's repos live under. Only repos below it are shared between teammates.
PLAYER_TWO_REPOS=https://dev.azure.com/your-organisation/
# Optional: a folder holding player-two-setup.exe, wsl-runtime.tar.gz and wsl-runtime.tar.gz.sha256, served to teammates at / and /install.sh.
# PLAYER_TWO_DOWNLOADS=./release
